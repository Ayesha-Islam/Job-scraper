{
  "name": "job-scraper-api",
  "version": "1.0.0",
  "description": "API package for job-scraper",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist && rimraf 'src/**/*.js' 'src/**/*.js.map' 'src/**/*.d.ts' 'src/**/*.d.ts.map'",
    "prebuild": "npm run clean",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "scrape": "tsx src/scrape.ts",
    "benchmark:descriptions": "node --import tsx scripts/benchmark-description-cleaning.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ayesha-Islam/Job-scraper"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "7.8.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "prisma": "7.8.0",
    "puppeteer": "^24.33.0",
    "resend": "^6.6.0",
    "tsx": "^4.22.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "nodemon": "^3.1.11",
    "rimraf": "^5.0.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "types": "module",
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
