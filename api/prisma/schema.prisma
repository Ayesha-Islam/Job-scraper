generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id          String   @id @default(uuid())
  company     String
  position    String
  location    String?
  salary      String?
  type        JobType  @default(FULL_TIME)
  url         String
  source      String
  description String?  @default("")
  postedAt    DateTime @default(now())

  companyKey  String
  positionKey String
  locationKey String

  isActive  Boolean  @default(true)
  scrapedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyKey, positionKey, locationKey])
  @@index([source])
  @@index([createdAt])
  @@index([isActive])
  @@index([companyKey])
  @@index([positionKey])
  @@index([locationKey])
}

model ScrapeLog {
  id           String       @id @default(uuid())
  source       String
  status       ScrapeStatus
  jobsFound    Int
  jobsAdded    Int
  errorMessage String?
  durationMs   Int
  completedAt  DateTime     @default(now())

  @@index([source])
  @@index([status])
  @@index([completedAt])
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  createdAt  DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ScrapeStatus {
  SUCCESS
  FAILED
}
