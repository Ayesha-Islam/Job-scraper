# Docker Compose variables
POSTGRES_USER=jobuser
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=jobscraper
POSTGRES_PORT=5432

# Generate independent random values for these secrets.
JWT_SECRET=replace-with-a-long-random-backend-secret
AUTH_SECRET=replace-with-a-long-random-frontend-secret

# Comma-separated email addresses allowed to call /api/v1/admin/*.
ADMIN_EMAILS=admin@example.com

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
FRONTEND_URL=http://localhost:3000
DB_SSL=false
